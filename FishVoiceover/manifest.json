{
  "manifest_version": 3,
  "name": "Fish Voiceover for Kdenlive",
  "version": "1.0.0",
  "description": "Voices over a Kdenlive transcript with fish.audio, keeping every line at its timeline position, and saves one WAV.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "downloads", "clipboardWrite"],
  "host_permissions": ["https://api.fish.audio/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Kdenlive voiceover"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://fish.audio/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
